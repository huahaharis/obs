# ---------------------------------------------------
# 📦 Node dependencies
# ---------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------
# 🏗️ Build output
# ---------------------------------------------------
dist/
dist-ssr/
build/
*.local
*.tmp
*.temp

# If deploying static site to GitHub Pages, uncomment below
# !dist/
# !dist/index.html
# !dist/assets/**

# ---------------------------------------------------
# 🧪 Test & Coverage
# ---------------------------------------------------
coverage/
.vitest/
jest-cache/
jest-report/

# ---------------------------------------------------
# ⚙️ Environment files (keep secrets out of git)
# ---------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Optional example env (keep for GitHub users)
!.env.example

# ---------------------------------------------------
# 🧩 Editor & System files
# ---------------------------------------------------
.vscode/
.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------------------------------------------------
# 🌀 CSS / Tailwind cache
# ---------------------------------------------------
*.css.map
.postcss-cache/

# ---------------------------------------------------
# 🧱 TypeScript
# ---------------------------------------------------
*.tsbuildinfo

# ---------------------------------------------------
# 🧰 Custom folders or temporary code
# ---------------------------------------------------
code/
logs/
*.log

# ---------------------------------------------------
# 🚀 Optional: GitHub Actions cache or outputs
# ---------------------------------------------------
.github/workflows/*.tmp
.github/workflows/*.bak
.vercel
